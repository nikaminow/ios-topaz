diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 4a2432a..92887cd 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -863,17 +863,30 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
 			for (uint32_t done = 0; done < count; done += 4) {
 				uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
 				ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
-				if (ud.events++ < 200) {
+				/* disk mode: no per-event lines, the console draws slower than USB */
+				if (ud.events++ < 200 && !ud.disk) {
 					printf("SWEET USB: event 0x%08x\n", ev);
 				}
 				ud_event(ev);
 			}
 			dwc_wr(GEVNTCOUNT, count);
 		}
-		if ((++ticks % 30000) == 0) {
+		if ((++ticks % 30000) == 0 && !ud.disk) {
 			printf("SWEET USB: ue0 rx %llu tx %llu frames\n", ud.rx_frames, ud.tx_frames);
 		}
-		ud_sleep_ms(1);
+		/*
+		 * Disk mode: every root block waits on this loop, so poll every 20 us
+		 * (one of seven cores) instead of every 1 ms.
+		 */
+		if (ud.disk) {
+			/* block, not spin: a spinning kernel thread starved the I/O waiters */
+			uint64_t dl;
+			clock_interval_to_deadline(50, NSEC_PER_USEC, &dl);
+			(void)assert_wait_deadline(&ud.sleep_chan, THREAD_UNINT, dl);
+			thread_block(THREAD_CONTINUE_NULL);
+		} else {
+			ud_sleep_ms(1);
+		}
 	}
 }
 
@@ -1090,12 +1103,19 @@ static dev_t udk_bdev;
 static int
 udk_wait(volatile bool *flag)
 {
-	uint64_t deadline, end;
+	uint64_t deadline, end, slow;
+	bool told = false;
 	clock_interval_to_deadline(UDK_TIMEOUT_MS, NSEC_PER_MSEC, &end);
+	clock_interval_to_deadline(2000, NSEC_PER_MSEC, &slow);
 	while (!*flag) {
 		if (mach_absolute_time() > end) {
 			return ETIMEDOUT;
 		}
+		if (!told && mach_absolute_time() > slow) {
+			told = true;
+			printf("SWEET USB DISK: seq %u waits >2 s for %s (DSTS 0x%08x)\n", udk_seq,
+			    flag == &ud.disk_tx_done ? "the PC to read (IN)" : "the PC's reply (OUT)", dwc_rd(DSTS));
+		}
 		clock_interval_to_deadline(5, NSEC_PER_MSEC, &deadline);
 		(void)assert_wait_deadline((event_t)flag, THREAD_UNINT, deadline);
 		thread_block(THREAD_CONTINUE_NULL);
@@ -1387,6 +1407,9 @@ sweet_usbdisk_rootdev(dev_t *dev)
 	devfs_make_node(udk_bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "usbdisk0");
 	devfs_make_node(makedev(cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rusbdisk0");
 	printf("SWEET USB DISK: %llu MiB root disk from the PC\n", udk_size >> 20);
+	/* where userland gets stuck (boot-arg sweetsample=NAME,...), as with ufsroot0 */
+	extern void sweet_sample_start(void);
+	sweet_sample_start();
 	*dev = udk_bdev;
 	return 0;
 }
