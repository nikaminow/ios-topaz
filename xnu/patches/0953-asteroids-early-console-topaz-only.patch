diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index bce302c..658ebc1 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -347,6 +347,16 @@ arm_init(
 	DTEntry chosen = NULL;
 	unsigned int dt_entry_size = 0;
 
+#if defined(SWEET)
+	/*
+	 * The early console draws at a fixed topaz address (start.s, sweet_early.c).
+	 * On any other board (asteroids: that RAM is the WPSS firmware carve-out)
+	 * the shim passes its own framebuffer, and the early console stays off.
+	 */
+	if (args->Video.v_baseAddr != SWEET_EARLY_FB_BOOTARG) {
+		sweet_early_disable();
+	}
+#endif
 	sweet_early_mark(1, "arm_init entered (MMU on)");
 
 	arm_setup_pre_sign();
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 1fd9f5a..dabb42c 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1838,6 +1838,9 @@ static void
 sweet_early_map_final(void)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
+	if (!sweet_early_enabled()) {
+		return;	/* not topaz: no alias of a fixed topaz address */
+	}
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	if ((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) != (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
 		return;
@@ -1875,6 +1878,9 @@ static void
 sweet_early_map_final(void)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
+	if (!sweet_early_enabled()) {
+		return;	/* not topaz: no alias of a fixed topaz address */
+	}
 	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index b91a5dc..27247d7 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -514,6 +514,16 @@ LEXT(start_first_cpu)
 	mov		x21, #0
 
 #if defined(SWEET)
+	/*
+	 * Only the topaz shim passes the topaz splash (Video.v_baseAddr, boot_args
+	 * +40) that the stage-0 band and the early-console mappings below assume;
+	 * any other board (asteroids) skips them: there that RAM is a firmware
+	 * carve-out. arm_init() turns the C side of the console off to match.
+	 */
+	ldr		x0, [x20, #40]
+	MOV64	x1, 0x5c000000
+	cmp		x0, x1
+	b.ne	Lsweet_mark_done
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
 #if defined(TOPAZ_4K)
 	MOV64	x0, (0x5c000000 + 2368 * 4320)	/* topaz splash framebuffer */
@@ -534,6 +544,7 @@ Lsweet_mark_pixel:
 	subs	x2, x2, #1
 	b.ne	Lsweet_mark_row
 	dsb		sy
+Lsweet_mark_done:
 #endif
 
 	// Set low reset vector before attempting any loads
@@ -682,6 +693,13 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(SWEET)
+	/* No early-console mappings unless the topaz shim booted us (see above). */
+	ldr		x10, [x20, #40]
+	MOV64	x11, 0x5c000000
+	cmp		x10, x11
+	b.ne	Lsweet_fb_map_done
+#endif
 #if defined(SWEET) && defined(TOPAZ_4K)
 	/*
 	 * topaz splash framebuffer (0x5c000000, 1080x2400x4 = 10 MB) VA=PA as
@@ -719,6 +737,9 @@ Ltopaz_fb_block:
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+#endif
+#if defined(SWEET)
+Lsweet_fb_map_done:
 #endif
 
 	/* Ensure TTEs are visible */
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 2e3e3a5..9f790ab 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -144,4 +144,10 @@ sweet_early_disable(void)
 	early_disabled = 1;
 	__asm__ volatile("dsb sy" ::: "memory");
 }
+
+int
+sweet_early_enabled(void)
+{
+	return !early_disabled;
+}
 #endif /* SWEET */
diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
index aa76172..4d682ed 100644
--- a/osfmk/arm64/sweet_early.h
+++ b/osfmk/arm64/sweet_early.h
@@ -7,6 +7,9 @@
 #include <stdint.h>
 
 #if defined(SWEET)
+/* boot_args Video.v_baseAddr from the topaz shim: only then is the early console on */
+#define SWEET_EARLY_FB_BOOTARG 0x5c000000ULL
+int sweet_early_enabled(void);
 void sweet_early_mark(unsigned int stage, const char *label);
 void sweet_early_putc(char c);
 void sweet_early_panic(const char *fmt, va_list *args);
