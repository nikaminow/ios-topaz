+/*
+ * The cpufreq, I2C1 gauge and charger registers are topaz (SM6225) MMIO. Any
+ * other board (asteroids, whose ADT root lacks "xiaomi,topaz") gets the static
+ * source and no register access.
+ */
+static bool
+sweet_board_is_topaz(void)
+{
+	DTEntry root;
+	void const *prop;
+	unsigned int size;
+
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", &prop, &size) != kSuccess) {
+		return false;
+	}
+	static const char want[] = "xiaomi,topaz";
+	const char *s = (const char *)prop;
+	/* compatible is a list of NUL-terminated strings */
+	for (unsigned int off = 0; off < size;) {
+		unsigned int len = 0;
+		while (off + len < size && s[off + len] != '\0') {
+			len++;
+		}
+		if (len == sizeof(want) - 1 && memcmp(s + off, want, len) == 0) {
+			return true;
+		}
+		off += len + 1;
+	}
+	return false;
+}
