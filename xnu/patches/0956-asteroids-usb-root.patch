+/* Root mode: the next bulk OUT chunk, DMA straight into the RAM disk. */
+static void
+ud_root_arm(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+	uint64_t left = ud.root_size - ud.root_off;
+	uint64_t pa = ud.root_pa + ud.root_off;
+
+	ud.root_chunk = left < UD_ROOT_CHUNK ? (uint32_t)left : UD_ROOT_CHUNK;
+	/* no dirty lines may be written back over what the controller writes */
+	flush_dcache64((addr64_t)pa, ud.root_chunk, TRUE);
+	t[0] = (uint32_t)pa;
+	t[1] = (uint32_t)(pa >> 32);
+	t[2] = ud.root_chunk;
+	t[3] = TRBCTL_NORMAL | TRB_HWO | TRB_LST | TRB_ISP_IMI | TRB_IOC;
+	ud_sync(UD_TRB_RX, 16);
+	uint64_t tpa = ud.dma_pa + UD_TRB_RX;
+	ud_epcmd(EP_RX, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
+}
+
+static void
+ud_root_done(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+	ud_sync(UD_TRB_RX, 16);
+	uint32_t len = ud.root_chunk - (t[2] & 0xffffff);
+	flush_dcache64((addr64_t)(ud.root_pa + ud.root_off), len, TRUE);  /* drop stale lines */
+	uint64_t before = ud.root_off;
+	ud.root_off += len;
+	if ((ud.root_off >> 26) != (before >> 26)) {    /* every 64 MiB */
+		printf("SWEET USB ROOT: %llu / %llu MiB\n", ud.root_off >> 20, ud.root_size >> 20);
+	}
+	/* a short packet or the full size ends the image */
+	if (ud.root_off >= ud.root_size || len < ud.root_chunk) {
+		ud.root_done = true;
+		return;
+	}
+	ud_root_arm();
+}
+
 static void
 ud_rx_arm(void)
 {
+	if (ud.root_pa) {
+		ud_root_arm();
+		return;
+	}
 	ud_start_trb(EP_RX, UD_TRB_RX, UD_RX, UD_FRAME_MAX, TRBCTL_NORMAL);
 }
 
 static void
 ud_rx_done(void)
 {
+	if (ud.root_pa) {
+		ud_root_done();
+		return;
+	}
 	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
 	ud_sync(UD_TRB_RX, 16);
 	uint32_t len = UD_FRAME_MAX - (t[2] & 0xffffff);
