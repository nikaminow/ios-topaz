 	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
 	dwc_wr(DCTL, DCTL_CSFTRST);
@@ -892,4 +977,44 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 		thread_deallocate(thread);
 	}
 }
+
+/*
+ * asteroids: receive the root image over USB into the RAM disk at [pa, pa +
+ * size) before IOFindBSDRoot turns it into md0 (boot-arg usbroot=1; the PC
+ * runs tools/usb-root-send.py). ABL leaves the DWC3 at 0x0a600000 clocked,
+ * in device mode and halted with the PHY up (asteroids probe v3: GSNPSID
+ * 0x5533330a), so only the device controller is restarted, as on sweet; no
+ * GCC or PHY register is touched. Blocks until the image is in.
+ */
+int
+sweet_usb_root_receive(uint64_t pa, uint64_t size)
+{
+	vm_offset_t dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
+	if (dwc == 0) {
+		printf("SWEET USB ROOT: DWC3 map failed\n");
+		return -1;
+	}
+	uint32_t id = usb_rd(dwc, 0xc120);
+	if ((id >> 16) != 0x5533) {
+		printf("SWEET USB ROOT: no DWC3 at 0x%x (GSNPSID 0x%08x)\n", DWC3_PA, id);
+		return -1;
+	}
+	ud.root_pa = pa;
+	ud.root_size = size;
+	ud.root_off = 0;
+	ud.root_done = false;
+	printf("SWEET USB ROOT: waiting for %llu MiB at 0x%llx: run tools/usb-root-send.py on the PC\n",
+	    size >> 20, pa);
+	sweet_usb_gadget_start(dwc);
+	uint64_t deadline;
+	while (!ud.root_done) {
+		clock_interval_to_deadline(100, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&ud.root_done, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	printf("SWEET USB ROOT: %llu MiB received\n", ud.root_off >> 20);
+	/* detach from the host; the event thread keeps polling an idle controller */
+	dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+	return 0;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
