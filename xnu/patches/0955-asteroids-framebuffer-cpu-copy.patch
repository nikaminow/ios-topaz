+/*
+ * MDP (VIG0, CTL0, INTF1), DSI, modem, audio and Adreno are SM6225 (topaz)
+ * registers. On any other board (asteroids: no "xiaomi,topaz" in the ADT root)
+ * they stay unmapped (NULL): frames reach the panel by CPU copy into the
+ * framebuffer ABL left scanning out.
+ */
+static bool
+sweet_fb_board_is_topaz(void)
+{
+	static const char want[] = "xiaomi,topaz";
+	DTEntry root;
+	void const *prop;
+	unsigned int size;
+
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", &prop, &size) != kSuccess) {
+		return false;
+	}
+	const char *s = (const char *)prop;
+	for (unsigned int off = 0; off < size;) {
+		unsigned int len = 0;
+		while (off + len < size && s[off + len] != '\0') {
+			len++;
+		}
+		if (len == sizeof(want) - 1 && memcmp(s + off, want, len) == 0) {
+			return true;
+		}
+		off += len + 1;
+	}
+	return false;
+}
